# ===================================
# Environment & Secrets (NEVER COMMIT)
# ===================================
.env
*.env
*.pem
*.key
secrets.json

# ===================================
# Local User Data & Vector Database
# ===================================
chroma_db/
data/chroma_db/
*.chroma

# PDF storage (ignore files, keep folder)
pdfs/*
!pdfs/.gitkeep
raw/pdfs/*
!raw/pdfs/.gitkeep
raw/extracted/*
!raw/extracted/.gitkeep
raw/articles/*
!raw/articles/.gitkeep
raw/screenshots/*
!raw/screenshots/.gitkeep
raw/notes/*
!raw/notes/.gitkeep

# Chat History & Context Sessions
chat_history/*
!chat_history/.gitkeep
ctx/sessions/*
!ctx/sessions/.gitkeep

# ===================================
# Large GGUF Model Files (> 2GB)
# ===================================
models/*
!models/.gitkeep
*.gguf
*.bin

# ===================================
# Node & Frontend
# ===================================
node_modules/
frontend/node_modules/
.npm/

# ===================================
# Databases & Raw User Data
# ===================================
data/*.db
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3
output/reports/*
!output/reports/.gitkeep
output/notes/*
!output/notes/.gitkeep
output/summaries/*
!output/summaries/.gitkeep
output/quizzes/*
!output/quizzes/.gitkeep

# ===================================
# Python & Virtual Environments
# ===================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
build/
develop-eggs/
dist/
!frontend/dist/
!frontend/dist/**

downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ===================================
# Temporary & Log Files
# ===================================
*.tmp
*.log
*.bak
*.swp

# ===================================
# IDE, OS & System Files
# ===================================
.vscode/
.idea/
*.sublime-workspace
*.sublime-project
.DS_Store
Thumbs.db
desktop.ini