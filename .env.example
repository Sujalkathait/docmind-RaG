# DocMind RAG — Local Configuration
# No API keys needed! Everything runs locally.

# Path to the Qwen2.5 3B GGUF model file
MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf

# GPU acceleration (NVIDIA CUDA only)
# Set to -1 to offload all layers to GPU, or 0 for CPU-only
N_GPU_LAYERS=0

# Context window size (tokens) — 8192 allows full trace tables, complete dry runs, and multi-chunk RAG
N_CTX=8192

# Output token generation limit
MAX_TOKENS=2048

# Prompt batch size (higher = faster prompt processing)
N_BATCH=512

# CPU threads (0 = auto-detect)
N_THREADS=0