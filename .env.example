# DocMind RAG — Local Configuration
# No API keys needed! Everything runs locally.

# Path to the GGUF model file (auto-detected if placed in models/ folder)
# Examples:
  MODEL_PATH=models/SmolLM2-360M-Instruct-Q4_K_M.gguf  (~258 MB, ultra-lightweight)
  MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf    (~2.0 GB, recommended CS tutor)
#MODEL_PATH=models/qwen2.5-3b-instruct-q4_k_m.gguf

# GPU acceleration (NVIDIA CUDA only)
# Set to -1 to offload all layers to GPU, or 0 for CPU-only
N_GPU_LAYERS=0

# Context window size (tokens) — 8192 allows full trace tables, complete dry runs, and multi-chunk RAG
N_CTX=8192

# Output token generation limit
MAX_TOKENS=2048

# Prompt batch size (higher = faster prompt processing)
N_BATCH=512

# CPU threads (0 = auto-detect)
N_THREADS=0

# ==========================================
# Optional Second Brain Storage Path Overrides
# ==========================================
# PDF_FOLDER=raw/pdfs
# CHAT_HISTORY_DIR=ctx/sessions
# CHROMA_PATH=data/chroma_db